<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#101713" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NEXT FACE" android:textColor="#22C55E" android:textSize="28sp" android:textStyle="bold" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="PREMIUM | CONTROLE DE ACESSO" android:textColor="#9CAFA3" android:textSize="12sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Dashboard" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:text="Gerencie seu sistema de reconhecimento facial." android:textColor="#9CAFA3" android:textSize="14sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="VISAO GERAL" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@drawable/bg_premium_card" android:id="@+id/statPessoas"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="--" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:id="@+id/valorPessoas" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Pessoas" android:textColor="#A2B5A8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" /></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@drawable/bg_premium_card" android:layout_marginStart="10dp" android:id="@+id/statReconhecimentos"><TextView android:id="@+id/valorReconhecimentos" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="--" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Reconhecimentos" android:textColor="#A2B5A8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" /></LinearLayout></LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@drawable/bg_premium_card" android:id="@+id/statAutorizados"><TextView android:id="@+id/valorAutorizados" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="--" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Autorizados" android:textColor="#A2B5A8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" /></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@drawable/bg_premium_card" android:layout_marginStart="10dp" android:id="@+id/statNegados"><TextView android:id="@+id/valorNegados" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="--" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Negados" android:textColor="#A2B5A8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" /></LinearLayout></LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" android:text="ACESSO RAPIDO" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />

</LinearLayout><TextView android:id="@+id/btnReconhecimento" style="@style/PremiumMenuCard" android:text="RECONHECIMENTO FACIAL" />

        <TextView android:id="@+id/btnPessoas" style="@style/PremiumMenuCard" android:text="PESSOAS" />

        <TextView android:id="@+id/btnHistorico" style="@style/PremiumMenuCard" android:text="HISTORICO" />

        <TextView android:id="@+id/btnSeguranca" style="@style/PremiumMenuCard" android:text="SEGURANCA" />

        <TextView android:id="@+id/btnConfiguracoes" style="@style/PremiumMenuCard" android:text="CONFIGURACOES" />

    </LinearLayout>
</ScrollView>