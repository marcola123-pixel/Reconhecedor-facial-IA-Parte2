<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101713"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/btnVoltarPessoas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← VOLTAR"
            android:textColor="#22C55E"
            android:textSize="15sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Pessoas cadastradas"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoTotalPessoas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Carregando..."
            android:textColor="#A2B5A8"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnAtualizarPessoas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_premium_card"
            android:gravity="center"
            android:padding="16dp"
            android:text="ATUALIZAR LISTA"
            android:textColor="#22C55E"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/listaPessoas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
